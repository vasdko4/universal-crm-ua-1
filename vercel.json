{
    "crons": [
      {
        "path": "/api/cron/delivery-sync",
        "schedule": "0 7 * * *"
      },
      {
        "path": "/api/cron/analytics-retention",
        "schedule": "15 3 * * *"
      },
      {
        "path": "/api/cron/expire-pending",
        "schedule": "30 4 * * *"
      },
      {
        "path": "/api/cron/anomaly-alert",
        "schedule": "0 8 * * *"
      },
      {
        "path": "/api/cron/db-backup",
        "schedule": "30 0 * * *"
      },
      {
        "path": "/api/cron/prom-sync",
        "schedule": "15 6 * * *"
      }
    ],
    "headers": [
      {
        "source": "/(.*)",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          }
        ]
      }
    ]
  }
